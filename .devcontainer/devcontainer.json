{
  "name": "Claude Code Workshop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",

  // Host machine requirements
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },

  "features": {
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "workbench.startupEditor": "readme",
        // Open root Markdown files in preview and lab-created subdirectory Markdown files as text.
        "workbench.editorAssociations": {
          "**/.claude/skills/api-checker/*.md": "default",
          "**/.claude/agents/*.md": "default",
          "**/.claude/commands/*.md": "default",
          "*.md": "vscode.markdown.preview.editor"
        }
      }
    }
  },

  // npm install works inside this Node container; note Anthropic's recommended path for
  // local installs is now the native installer: curl -fsSL https://claude.ai/install.sh | bash
  "postCreateCommand": "npm install -g @anthropic-ai/claude-code && cp -n extra/.claude.json ~/ ; grep -qs claude-yolo ~/.bash_aliases || echo 'alias claude-yolo=\"claude --dangerously-skip-permissions\"' >> ~/.bash_aliases",

  "postAttachCommand": "cp -n extra/.claude.json ~/ ; grep -qs claude-yolo ~/.bash_aliases || echo 'alias claude-yolo=\"claude --dangerously-skip-permissions\"' >> ~/.bash_aliases",

  "remoteUser": "node",

  "mounts": [
    "source=${localEnv:HOME}/.anthropic,target=/home/node/.anthropic,type=bind,consistency=cached"
  ]
}

